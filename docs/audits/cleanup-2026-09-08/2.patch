+:root {
+  --bg: #f6f5f1;
+  --bg-0: #efeee9;
+  --bg-raised: #fff;
+  --bg-sunk: #eeede8;
+  --text: #252724;
+  --text-dim: #6c7069;
+  --text-faint: #8c918a;
+  --line: #ddded7;
+  --line-strong: #c8ccc2;
+  --font: Arial,Helvetica,sans-serif;
+  --accent: #36694a;
+  --mono: 'SFMono-Regular',Consolas,monospace;
+  color-scheme: light;
+}
+
+* {
+  box-sizing: border-box;
+}
+
+html {
+  scroll-behavior: smooth;
+}
+
+body {
+  margin: 0;
+  background: var(--bg);
+  color: var(--text);
+  font-family: Arial,Helvetica,sans-serif;
+  -webkit-font-smoothing: antialiased;
+}
+
+a {
+  color: inherit;
+  text-decoration: none;
+}
+
+button,input {
+  font: inherit;
+}
+
+button:focus-visible,a:focus-visible,input:focus-visible {
+  outline: 2px solid #538462;
+  outline-offset: 5px;
+}
+
+button {
+  cursor: pointer;
+  transition: background .18s ease,color .18s ease,transform .18s ease;
+}
+
+button:active {
+  transform: scale(.97);
+}
+
+::selection {
+  background: #c6d7bd;
+  color: #18251c;
+}
+
+.studio-header {
+  height: 104px;
+  max-width: 1600px;
+  margin: auto;
+  padding: 0 5%;
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  gap: 32px;
+  border-bottom: 1px solid var(--line);
+}
+
+.studio-brand {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  font-size: 19px;
+  font-weight: 650;
+  letter-spacing: -.8px;
+  white-space: nowrap;
+}
+
+.brand-light {
+  font-weight: 400;
+}
+
+.studio-brand sup {
+  font-size: 10px;
+  align-self: flex-start;
+  margin-top: 4px;
+  margin-left: 6px;
+  letter-spacing: 0;
+}
+
+.studio-links {
+  display: flex;
+  align-items: center;
+  gap: 32px;
+  font-size: 13px;
+}
+
+.studio-links a {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  color: #676c63;
+}
+
+.studio-links a.active,.studio-links a:hover {
+  color: #17281c;
+}
+
+.studio-links a:last-child {
+  border-left: 1px solid var(--line);
+  padding-left: 32px;
+}
+
+.menu-button {
+  display: none;
+  background: none;
+  border: 0;
+}
+
+.site-main {
+  min-height: 65vh;
+}

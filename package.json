{
  "name": "simple-liquid-glass",
  "version": "5.1.1",
  "type": "module",
  "description": "Zero-dependency liquid glass for React 16.8–19, with SVG refraction, an explicit DOM-mirror fallback for Safari/Firefox, and a framework-agnostic web component.",
  "main": "dist/index.cjs",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs"
    },
    "./interactive": {
      "types": "./dist/interactive.d.ts",
      "import": "./dist/interactive.esm.js",
      "require": "./dist/interactive.cjs"
    },
    "./mirror": {
      "types": "./dist/mirror.d.ts",
      "import": "./dist/mirror.esm.js",
      "require": "./dist/mirror.cjs"
    },
    "./web-component": {
      "types": "./dist/web-component.d.ts",
      "import": "./dist/web-component.esm.js",
      "require": "./dist/web-component.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "llms.txt",
    "skills"
  ],
  "scripts": {
    "build": "rollup -c && tsc && rollup -c rollup.types.config.js",
    "dev": "rollup -c -w",
    "test": "jest",
    "size": "size-limit",
    "prepublishOnly": "npm run typecheck && npm test -- --runInBand && npm run build && npm run test:types && npm run size",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck": "tsc --noEmit",
    "test:browser": "playwright test",
    "test:compat": "node scripts/check-compat.cjs",
    "test:types": "tsc -p tests/types/tsconfig.json"
  },
  "size-limit": [
    {
      "name": "core — import { LiquidGlass } (Brotli, includes iOS mirror engine)",
      "path": "dist/index.esm.js",
      "limit": "15 KB",
      "ignore": [
        "react",
        "react-dom"
      ]
    },
    {
      "name": "interactive — import { LiquidGlassInteractive } (Brotli, bundles core)",
      "path": "dist/interactive.esm.js",
      "limit": "17 KB",
      "ignore": [
        "react",
        "react-dom"
      ]
    },
    {
      "name": "mirror — import { LiquidGlassMirror } (Brotli, bundles core)",
      "path": "dist/mirror.esm.js",
      "limit": "15 KB",
      "ignore": [
        "react",
        "react-dom"
      ]
    },
    {
      "name": "web-component — <liquid-glass> (Brotli, no React)",
      "path": "dist/web-component.esm.js",
      "limit": "6 KB"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucaperullo/simple-liquid-glass.git"
  },
  "keywords": [
    "liquid-glass",
    "liquid-glass-react",
    "react-liquid-glass",
    "apple-liquid-glass",
    "ios-glass",
    "ios-26",
    "safari-glass",
    "firefox-glass",
    "cross-browser",
    "webkit",
    "glassmorphism",
    "glass-morphism",
    "glassmorphism-react",
    "frosted-glass",
    "glass-effect",
    "refraction",
    "displacement-map",
    "chromatic-aberration",
    "backdrop-filter",
    "svg-filter",
    "web-component",
    "custom-element",
    "interactive",
    "pointer-elasticity",
    "ssr",
    "server-side-rendering",
    "nextjs",
    "lightweight",
    "zero-dependencies",
    "tiny",
    "accessibility",
    "a11y",
    "react",
    "react-16",
    "react-17",
    "react-18",
    "react-19",
    "glass-ui",
    "glass-card",
    "glass-panel",
    "apple-design"
  ],
  "author": "lucaperullo",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/lucaperullo/simple-liquid-glass/issues"
  },
  "homepage": "https://simple-liquid-glass.vercel.app/",
  "overrides": {
    "serialize-javascript": "^7.0.5",
    "tar": "^7.5.16",
    "uuid": "^11.1.1",
    "esbuild": "^0.28.1"
  },
  "peerDependencies": {
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@babel/preset-react": "^7.22.0",
    "@babel/preset-typescript": "^7.27.1",
    "@playwright/test": "^1.63.0",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@size-limit/preset-small-lib": "^12.1.0",
    "@storybook/addon-docs": "^10.4.4",
    "@storybook/react": "^10.4.4",
    "@storybook/react-vite": "^10.4.4",
    "@testing-library/jest-dom": "^6.1.4",
    "@testing-library/react": "^16.1.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "pngjs": "^7.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rollup": "^4.0.0",
    "rollup-plugin-dts": "^6.1.0",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "size-limit": "^12.1.0",
    "storybook": "^10.4.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
